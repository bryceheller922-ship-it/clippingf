# ---- Team logins (you + your business partner) ----
# Comma-separated username:password pairs.
APP_USERS="bryce:change-me,partner:change-me-too"

# ---- TikTok (developers.tiktok.com -> your app -> Credentials) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Any long random string (32+ chars). Encrypts stored tokens/keys and signs sessions.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Optional. Defaults to https://<current-host>/api/auth/callback.
# Must exactly match a Redirect URI registered in your TikTok app.
# TIKTOK_REDIRECT_URI=

# ---- Storage (provided automatically by Vercel integrations) ----
# Vercel Blob store (Storage -> Blob): video file storage
BLOB_READ_WRITE_TOKEN=
# Upstash Redis (Storage -> Upstash for Redis): shared workspace data
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# ---- Optional API keys (can also be set in the app's Settings page) ----
# Groq: powers agent containers using the Groq preset (console.groq.com/keys)
GROQ_API_KEY=
# Whop: verifies your Whop company + pulls payment data (whop.com/dashboard/developer)
WHOP_API_KEY=
