# ---- Firebase Auth (console.firebase.google.com -> project settings -> web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Who may sign in to this workspace (comma-separated emails).
# Leave empty to allow anyone with a Firebase account on your project (not recommended).
ALLOWED_EMAILS="you@gmail.com,partner@gmail.com"

# ---- Supabase (supabase.com -> project -> Settings -> API) ----
# Run supabase/schema.sql in the SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- TikTok (developers.tiktok.com -> your app -> Credentials) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Any long random string (32+ chars). Encrypts stored tokens/keys and signs sessions.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Protects the Autopilot cron endpoint. Vercel sends it automatically as a
# Bearer token when this env var is set. Generate: openssl rand -hex 24
CRON_SECRET=

# Optional. Defaults to https://<current-host>/api/auth/callback.
# Must exactly match a Redirect URI registered in your TikTok app.
# TIKTOK_REDIRECT_URI=

# ---- Optional workspace-fallback API keys ----
# Each user normally saves their own keys in the app (My Keys page);
# these env vars act as fallbacks when a user hasn't.
GROQ_API_KEY=
WHOP_API_KEY=
BROWSERUSE_API_KEY=
