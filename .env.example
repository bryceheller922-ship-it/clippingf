# All values are set in the Vercel dashboard (Settings -> Environment Variables).
# No terminal needed anywhere.

# ---- Firebase Auth (console.firebase.google.com -> project settings -> your web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Who may sign in to this workspace (comma-separated emails).
ALLOWED_EMAILS="you@gmail.com,partner@gmail.com"

# ---- Supabase (supabase.com -> project -> Settings -> API) ----
# Run supabase/schema.sql in the Supabase SQL editor (in the browser) first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (32+ chars) — use any password generator, or mash the
# keyboard. Encrypts stored tokens/keys and signs sessions.
SESSION_SECRET=

# Another long random string. Protects the Autopilot cron endpoint; Vercel
# sends it automatically once set.
CRON_SECRET=

# ---- Everything below is OPTIONAL ----
# TikTok, Groq, Whop and Browser Use keys are entered PER USER inside the app
# (My Keys page). These env vars only act as workspace-wide fallbacks.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=
# GROQ_API_KEY=
# WHOP_API_KEY=
# BROWSERUSE_API_KEY=
