# From https://developers.tiktok.com -> your app -> Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Any long random string (32+ chars). Used to encrypt account tokens stored in cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Optional. Defaults to https://<current-host>/api/auth/callback.
# Must exactly match a Redirect URI registered in your TikTok app.
# TIKTOK_REDIRECT_URI=

# Provided automatically when you attach a Vercel Blob store to the project.
# For local dev, run `vercel env pull .env.local` after attaching the store.
BLOB_READ_WRITE_TOKEN=
